# ─────────────────────────────────────────────
# 智传非遗 · 环境变量模板
# 复制本文件为 server/.env 并填入真实值（.env 已被 gitignore，不会提交）
# ─────────────────────────────────────────────

# 后端端口（默认 3001）
PORT=3001

# 开发模式：true 时验证码直接显示在页面/接口返回中，不发送真实邮件
DEV_MODE=false

# ── 用户系统 ────────────────────────────────
# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=7d

# ── 邮箱验证码（SMTP）───────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@example.com
SMTP_PASS=your-smtp-password

# ── 阿里云百炼 DashScope（AI 对话 / TTS / 图片生成）────
# TTS 语音合成（cosyvoice）
DASHSCOPE_TTS_KEY=sk-xxxxxxxx
# AI 对话 + 图片生成（通义千问 / 万相）
DASHSCOPE_API_KEY=sk-xxxxxxxx

# ── Meshy 文生 3D ─────────────────────────────
MESHY_API_KEY=msy_xxxxxxxx

# ── 额度体系（个人中心，可不配置走默认值）─────
# 登录用户每日额度：对话/纹样生成/3D 生成（TTS 不限）
QUOTA_CHAT=60
QUOTA_PATTERN=10
QUOTA_MODEL3D=1
# 游客每日对话试用次数（纹样/3D 生成需登录，无游客额度）
GUEST_QUOTA_CHAT=5
# 会员每日额度倍数（模拟会员，默认 2 倍）
VIP_MULTIPLIER=2
